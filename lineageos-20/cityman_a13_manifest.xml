<?xml version="1.0" encoding="UTF-8"?>
<!-- Local manifest for the Lumia 950 XL (cityman), LineageOS 20 (Android 13).
     SKELETON: nothing below has been synced or built yet.

     Base tree: LineageOS Ultra Legacy, which carries the no-eBPF / old-kernel
     fixes for system/bpf, system/netd, Connectivity, system/core, frameworks
     and the legacy qcom sepolicy. repo init and repo sync commands are in
     README.md next to this file (XML comments cannot hold double dashes).

     The three giannoccarol branches named lineage-20-cityman exist only as
     local branches today; push them before syncing from GitHub. -->
<manifest>
  <!-- Device, kernel, vendor -->
  <project name="giannoccarol/android_device_msft_cityman" path="device/msft/cityman" remote="github" revision="lineage-20-cityman" />
  <!-- lineage-20-cityman = Android4Lumia950 lineage-21.0 (eBPF, cgroup, PSI,
       fscrypt backports, kernel version spoof) + lineage-18.1-cityman-next
       (Wi-Fi, MBA, RIL fixes). The camera branch still has to be merged. -->
  <project name="giannoccarol/android_kernel_mmo_msm8994" path="kernel/mmo/msm8994" remote="github" revision="lineage-20-cityman" />
  <project name="giannoccarol/android_vendor_msft_cityman" path="vendor/msft/cityman" remote="github" revision="lineage-20-cityman" />

  <!-- msm8994 HALs. vendor/lineage (UL) maps msm8992/msm8994 to
       hardware/qcom-caf/msm8994 (QCOM_HARDWARE_VARIANT). UL has a 20.0
       display branch for msm8994; media stays on the LineageOS 18.1
       msm8994 branch, as in the libra (MSM8992) LineageOS 20 tree. -->
  <project name="LineageOS-UL/android_hardware_qcom_display" path="hardware/qcom-caf/msm8994/display" remote="github" revision="lineage-20.0-caf-msm8994" />
  <!-- Audio: no qcom-caf/msm8994/audio. The device builds the generic
       hardware/qcom/audio HAL, the one the 18.1 ROM uses. -->
  <project name="LineageOS/android_hardware_qcom_media" path="hardware/qcom-caf/msm8994/media" remote="github" revision="lineage-18.1-caf-msm8994" />

  <!-- hardware/sony/timekeep (RTC offset, used on 18.1) is already in the
       LineageOS-UL 20.0 manifest. -->

  <!-- Dropped from the 18.1 cityman manifest:
       - Android4Lumia950/packages_modules_NetworkStack (11): UL ships its own.
       - Android4Lumia950/android_packages_apps_Updater: no cityman OTA server.
       - vendor/apn pin: the 20.0 manifest has no vendor/apn project.
       - Android4Lumia950/android_hardware_qcom_display at hardware/qcom/display:
         replaced by the qcom-caf/msm8994 display above.
       - lakgarg/packages_apps_GoogleCamera: add back once the rear camera
         gives frames on Android 13. -->

  <!-- Host prebuilts not needed on Linux (saves a few GB) -->
  <remove-project path="prebuilts/bazel/darwin-x86_64" />
  <remove-project path="prebuilts/clang/host/darwin-x86" />
  <remove-project path="prebuilts/go/darwin-x86" />


  <!-- LineageOS lineage-20.0 ContactsProvider 0b0bbfa (2026-05, SQL injection
       fix) needs SQLiteTokenizer.OPTION_CHECK_BRACKETS, which the
       LineageOS-UL frameworks/base does not have. Pinned with the 2025-04-05 snapshot below. -->
  <remove-project path="packages/providers/ContactsProvider" />
  <project path="packages/providers/ContactsProvider" name="LineageOS/android_packages_providers_ContactsProvider" groups="pdk-cw-fs,pdk-fs" remote="github" revision="41edc60825cbe5f95e1f7d5646481a19b0fafbd9" />

  <!-- Snapshot of 2025-04-05: LineageOS-UL forks (frameworks/base,
       telephony, art, ...) last merged LineageOS lineage-20.0 on 2025-04-04.
       Projects taken from LineageOS that build against them (apps, services,
       providers, libcore, skia, icu, build/make) are pinned to the last first-parent commit of
       lineage-20.0 before that day; their later commits use framework APIs the UL forks lack.
       Kept current on purpose: system/ca-certificates, system/timezone
       (data only) and the WebView. external/dng_sdk is pinned too: its DNG SDK
       1.7.1 update needs the LineageOS libjpeg-turbo and drops the Windows
       variant the 2024 skia links. -->
